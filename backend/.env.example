# Copy to backend/.env for local dev. Never commit the real file.
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=afterlight

# Staff login (single admin). Generate the hash with: python hash_password.py
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD_HASH=
# ADMIN_PASSWORD=only-for-local-dev     # plain-text alternative to the hash
JWT_SECRET=                              # 32+ random chars; hash_password.py prints one
COOKIE_SECURE=false                      # true in production (https)

# AI: one Google key does text + images
GEMINI_API_KEY=
# TEXT_MODEL=gemini-3.5-flash-lite
# IMAGE_MODEL=gemini-nano-banana-2.1
# FAL_KEY=                               # optional Kling video clips
# TEXT_PROVIDER=stub / IMAGE_PROVIDER=stub   # free placeholder output for testing
